# Envio de e-mail do site PT2VHF (formulário de contato, avisos de testadores e teste no /stats).
#
# NUNCA coloque a senha real neste arquivo nem em nenhum arquivo do repositório.
# Na Hostinger (hospedagem compartilhada, sem painel de variáveis para PHP), crie no Gerenciador de arquivos
# do hPanel o arquivo  pt2vhf-private-data/smtp.env  na pasta ACIMA do public_html, com estas linhas e a
# senha real. Variáveis de ambiente do servidor, se existirem, têm prioridade sobre o arquivo.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alex@pt2vhf.com
SMTP_PASSWORD=COLOCAR_A_SENHA_NAS_VARIAVEIS_DO_SERVIDOR
SMTP_FROM=alex@pt2vhf.com
SMTP_FROM_NAME=PT2VHF
CONTACT_RECIPIENT=alexpmr@gmail.com

# Configuração para hospedagem Apache/LiteSpeed (Hostinger)
Options -Indexes

# O deploy via Git da Hostinger publica o repositório inteiro em public_html:
# bloqueia arquivos internos (.git, .github, README etc.)
RedirectMatch 404 /\.(git|github|gitlab-ci\.yml|gitignore)
RedirectMatch 404 /README\.md$
ErrorDocument 404 /404.html

RewriteEngine On
# Força HTTPS e www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.pt2vhf.com%{REQUEST_URI} [L,R=301]

# As cinco páginas funcionam sem extensão e com barra final opcional.
# Redireciona URLs .html públicas, sem redirecionar a reescrita interna.
RewriteCond %{THE_REQUEST} "\\s/+((aprs|prop|mesh|sat|prog))\\.html(?:[?\\s])" [NC]
RewriteRule ^(aprs|prop|mesh|sat|prog)\\.html$ /$1 [R=301,L,NC]
RewriteRule ^(aprs|prop|mesh|sat|prog)/?$ $1.html [END,NC]

# Instaladores sempre como download
<FilesMatch "\.(exe|msi|zip|AppImage|deb|dmg|gz)$">
  Header set Content-Disposition attachment
  Header set X-Content-Type-Options nosniff
</FilesMatch>
AddType application/vnd.microsoft.portable-executable .exe
AddType application/x-msi .msi

# Arquivo de versões lido pelo site e pelos programas (verificação de atualizações)
<Files "updates.json">
  ForceType "application/json; charset=utf-8"
  Header set Content-Type "application/json; charset=utf-8"
  Header set Cache-Control "no-cache"
  Header set Access-Control-Allow-Origin "*"
</Files>

# Cache de arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>

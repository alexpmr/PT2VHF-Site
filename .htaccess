# Configuração para hospedagem Apache/LiteSpeed (Hostinger)
Options -Indexes

# O deploy via Git da Hostinger publica o repositório inteiro em public_html:
# bloqueia arquivos internos (.git, .github, README etc.)
RedirectMatch 404 /\.(git|github|gitlab-ci\.yml|gitignore)
RedirectMatch 404 /(README|CLAUDE)\.md$
ErrorDocument 404 /404.html

RewriteEngine On
# Força HTTPS e www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.pt2vhf.com%{REQUEST_URI} [L,R=301]

# URL oficial do APRS Android: mantém /android como endereço legado.
RewriteRule ^aprs-android/?$ android.html [END,NC]

# As seis páginas funcionam sem extensão e com barra final opcional.
# A condição THE_REQUEST limita o redirecionamento a requisições .html externas.
RewriteCond %{THE_REQUEST} "^[A-Z]+[ ]/+(aprs|android|prop|mesh|sat|prog|qsl|contato|sobre)[.]html([ ?]|$)" [NC]
RewriteRule ^(aprs|android|prop|mesh|sat|prog|qsl|contato|sobre)[.]html$ /$1 [R=301,L,NC]
RewriteRule ^(aprs|android|prop|mesh|sat|prog|qsl|contato|sobre)/?$ $1.html [END,NC]

# Parts of Prop Tool installers are never downloadable individually.
RewriteRule ^downloads/prop-tool/.*\.exe\.part(?:[0-9]{2}|s\.json)$ - [F,L,NC]
# Reconstruct a byte-identical .exe from <100 MiB files, counting OTA downloads.
# No external redirect: the desktop auto-updater requires a direct HTTP 200 response.
RewriteRule ^downloads/prop-tool/(PT2VHF-Prop-Tool-[0-9]+\.[0-9]+\.[0-9]+-x64-(?:setup|portable)\.exe)$ download.php?product=prop&file=$1 [L,NC,QSA]

# Sat Tool: mesmo esquema segmentado (EXEs > 100 MiB), servido com HTTP 200
# direto para o atualizador OTA, que recusa redirecionamentos.
RewriteRule ^downloads/sat-tool/.*\.exe\.part(?:[0-9]{2}|s\.json)$ - [F,L,NC]
RewriteRule ^downloads/sat-tool/(PT2VHF-Sat-Tool-v[0-9]+\.[0-9]+\.[0-9]+-Win11-x64-(?:Setup|Portable)\.exe)$ download.php?product=sat&file=$1 [L,NC,QSA]

# Contabiliza URLs diretas do APRS (inclusive downloads do atualizador).
# A segunda requisição, com pt2vhf_raw=1, serve o binário estático.
RewriteCond %{QUERY_STRING} !(^|&)pt2vhf_raw=1(&|$) [NC]
RewriteCond %{HTTP:Range} ^$
RewriteRule ^downloads/aprs-client/([A-Za-z0-9_.-]+\.(?:exe|AppImage|deb|tar\.gz))$ download.php?product=aprs&file=$1 [L,NC,QSA]

# APRS Client for Android: links diretos e o aviso de atualização do app passam
# pelo mesmo contador (uma contagem por download; pt2vhf_raw=1 serve o arquivo).
RewriteCond %{QUERY_STRING} !(^|&)pt2vhf_raw=1(&|$) [NC]
RewriteRule ^downloads/aprs-android/([A-Za-z0-9_.-]+\.apk)$ download.php?product=aprs-android&file=$1 [L,NC,QSA]

# Downloads do Mesh Analyzer (site, links diretos e OTA) passam pelo mesmo
# contador persistente do APRS, com uma única contagem por download inicial.
# pt2vhf_raw=1 identifica somente a resposta estática da segunda requisição.
# Pedidos Range são retomadas e não devem aumentar o contador.
RewriteCond %{QUERY_STRING} !(^|&)pt2vhf_raw=1(&|$) [NC]
RewriteCond %{HTTP:Range} ^$
RewriteRule ^downloads/mesh-analyzer/([A-Za-z0-9_.-]+\.(?:exe|zip|deb|dmg|tar\.gz))$ download.php?product=mesh&file=$1 [L,NC,QSA]

# Downloads do Prog Tool (site e OTA) contados uma única vez por download;
# pt2vhf_raw=1 marca a resposta estática e pedidos Range não contam.
RewriteCond %{QUERY_STRING} !(^|&)pt2vhf_raw=1(&|$) [NC]
RewriteCond %{HTTP:Range} ^$
RewriteRule ^downloads/prog-tool/(PT2VHFProgTool-[0-9]+\.[0-9]+\.[0-9]+-(?:instalador\.exe|windows-portatil\.zip)|pt2vhf-prog-tool_[0-9]+\.[0-9]+\.[0-9]+_all\.deb|pt2vhf-prog-tool-[0-9]+\.[0-9]+\.[0-9]+-linux\.tar\.gz)$ download.php?product=prog&file=$1 [L,NC,QSA]

# QSL Analyzer: todos os pacotes (Windows, Linux, macOS) ficam em partes < 100 MiB e são
# remontados pelo download.php (HTTP 200, Range), contando uma vez por download (site e OTA).
RewriteRule ^downloads/qsl-analyzer/.*\.part(?:[0-9]{2}|s\.json)$ - [F,L,NC]
RewriteRule ^downloads/qsl-analyzer/([A-Za-z0-9_.-]+\.(?:exe|AppImage|deb|tar\.gz|dmg))$ download.php?product=qsl&file=$1 [L,NC,QSA]

# Páginas sempre revalidadas: assim a marca ?v= dos scripts novos chega na hora
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>

# Instaladores sempre como download
<FilesMatch "\.(exe|msi|zip|AppImage|deb|dmg|gz|apk)$">
  Header set Content-Disposition attachment
  Header set X-Content-Type-Options nosniff
</FilesMatch>
AddType application/vnd.microsoft.portable-executable .exe
AddType application/x-msi .msi
AddType application/vnd.android.package-archive .apk
# Garantir visualização das capturas AVIF na hospedagem Hostinger.
AddType image/avif .avif

# Arquivo de versões lido pelo site e pelos programas (verificação de atualizações)
<Files "updates.json">
  ForceType "application/json; charset=utf-8"
  Header set Content-Type "application/json; charset=utf-8"
  Header set Cache-Control "no-cache"
  Header set Access-Control-Allow-Origin "*"
</Files>

# Cache de arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>
